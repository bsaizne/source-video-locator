{
  "appId": "com.videolocator.desktop",
  "productName": "Video Locator",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "out/electron/**/*"
  ],
  "asar": false,
  "extraResources": [
    {
      "from": "resources/backend",
      "to": "backend"
    },
    {
      "from": "resources/models",
      "to": "models"
    }
  ],
  "win": {
    "target": [
      {
        "target": "dir"
      }
    ],
    "signAndEditExecutable": false
  },
  "mac": {
    "target": [
      {
        "target": "zip",
        "arch": [
          "arm64"
        ]
      },
      {
        "target": "dir",
        "arch": [
          "arm64"
        ]
      }
    ],
    "identity": null,
    "category": "public.app-category.video"
  }
}